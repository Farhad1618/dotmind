{
  "name": "dotmind-native",
  "version": "0.2.0",
  "description": "Dot-matrix AI status indicators for React Native that follow what the model is doing: reasoning, calling tools, writing. Drawn with Skia at 60 fps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Farhad1618/dotmind.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/Farhad1618/dotmind/tree/main/packages/react-native#readme",
  "bugs": {
    "url": "https://github.com/Farhad1618/dotmind/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "default": "./dist/anthropic.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "default": "./dist/openai.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "default": "./dist/ai-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "link:core": "npm install --no-save ../dotmind",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "dotmind": "^0.2.0"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "react-native-reanimated": ">=4.0.0"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "^2.14.0",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-test-renderer": "^19.3.1",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-reanimated": "^4.8.0",
    "react-native-worklets": "^0.14.0",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "ai",
    "agent",
    "loader",
    "thinking",
    "indicator",
    "dot-matrix",
    "llm",
    "streaming",
    "react-native",
    "expo",
    "skia",
    "anthropic",
    "openai",
    "ai-sdk"
  ]
}
